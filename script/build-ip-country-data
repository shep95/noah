#!/usr/bin/env python3
"""Rebuilds crates/noah_device/data from the public-domain registry export.

Usage: script/build-ip-country-data <rir-ip-country-dir> <centroids.csv>

The first argument is the `country/` directory of a checkout of
https://github.com/ipverse/rir-ip (CC0); the second is `dist/countries.csv`
from https://github.com/gavinr/world-countries-centroids (MIT).
"""
import csv
import gzip
import ipaddress
import os
import struct
import sys

OUT_DIR = os.path.join(os.path.dirname(__file__), "..", "crates", "noah_device", "data")
UNKNOWN = 255
NAMES_WITHOUT_CENTROID = {
    "AX": ("Åland Islands", 60.2, 19.9),
    "HK": ("Hong Kong", 22.3, 114.2),
    "MO": ("Macao", 22.2, 113.5),
    "TW": ("Taiwan", 23.7, 121.0),
    "XK": ("Kosovo", 42.6, 20.9),
    "EU": ("European registry", float("nan"), float("nan")),
    "AP": ("Asia-Pacific registry", float("nan"), float("nan")),
}


def read_centroids(path):
    centroids = {}
    for row in csv.DictReader(open(path, encoding="utf-8")):
        iso = row["ISO"].strip().upper()
        if iso:
            centroids[iso] = (row["COUNTRY"].strip(), float(row["latitude"]), float(row["longitude"]))
    centroids.update(NAMES_WITHOUT_CENTROID)
    return centroids


def read_ranges(country_dir, codes, family):
    items = []
    for index, code in enumerate(codes):
        path = os.path.join(country_dir, code.lower(), f"{family}-aggregated.txt")
        if not os.path.exists(path):
            continue
        for line in open(path, encoding="utf-8"):
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            network = ipaddress.ip_network(line, strict=False)
            items.append((int(network.network_address), int(network.broadcast_address), index))
    items.sort()
    merged = []
    for start, end, code in items:
        if merged and start <= merged[-1][1]:
            if end <= merged[-1][1]:
                continue
            start = merged[-1][1] + 1
        if merged and merged[-1][2] == code and merged[-1][1] + 1 == start:
            merged[-1] = (merged[-1][0], end, code)
        else:
            merged.append((start, end, code))
    return merged


def encode(merged, width):
    out = bytearray()

    def push(start, code):
        if width == 4:
            out.extend(struct.pack(">I", start))
        else:
            out.extend(struct.pack(">QQ", start >> 64, start & ((1 << 64) - 1)))
        out.append(code)

    last_end = -1
    for start, end, code in merged:
        if start != last_end + 1:
            push(last_end + 1, UNKNOWN)
        push(start, code)
        last_end = end
    if last_end < (1 << (width * 8)) - 1:
        push(last_end + 1, UNKNOWN)
    return bytes(out)


def main():
    country_dir, centroids_path = sys.argv[1], sys.argv[2]
    centroids = read_centroids(centroids_path)
    codes = sorted(name.upper() for name in os.listdir(country_dir) if len(name) == 2)
    if len(codes) >= UNKNOWN:
        sys.exit("too many countries for one byte")
    for family, width in (("ipv4", 4), ("ipv6", 16)):
        data = encode(read_ranges(country_dir, codes, family), width)
        with open(os.path.join(OUT_DIR, f"{family}-country.bin.gz"), "wb") as out:
            out.write(gzip.compress(data, 9))
    lines = [
        "// Generated by script/build-ip-country-data from the CC0 ipverse/rir-ip",
        "// registry export and the MIT world-countries-centroids table. Do not edit.",
        "",
        "/// ISO 3166 code, English name, latitude, longitude. The index of an entry",
        "/// is the code stored in the address tables.",
        "pub(crate) const COUNTRIES: &[(&str, &str, f32, f32)] = &[",
    ]
    for code in codes:
        name, lat, lon = centroids.get(code, (code, float("nan"), float("nan")))
        lat_text = "f32::NAN" if lat != lat else f"{lat:.2f}"
        lon_text = "f32::NAN" if lon != lon else f"{lon:.2f}"
        lines.append(f'    ("{code}", "{name}", {lat_text}, {lon_text}),')
    lines.append("];")
    with open(os.path.join(OUT_DIR, "countries.rs"), "w", encoding="utf-8") as out:
        out.write("\n".join(lines) + "\n")


if __name__ == "__main__":
    main()
