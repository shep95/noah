#!/usr/bin/env bash
# Fetch the agent-browser binary (github.com/vercel-labs/agent-browser,
# Apache-2.0) that noah ships for shepherd's browser, from the pinned npm
# release, and verify it before use.
#
# Usage: script/fetch-agent-browser <platform> <destination-binary-path>
#   platform: linux-x64 | linux-arm64 | darwin-x64 | darwin-arm64 | win32-x64
# The license is written next to the binary as agent-browser-LICENSE.

set -euo pipefail

VERSION="0.38.1"
SHA512="939f050b3d3250e080368364322a897be1f6cbaafab1465acea5ec585f8c62ad62442e363e3b4b701a1a83a4924ce0ff151429a6f3c3bc4e470d8121725be787"

platform="${1:?platform, e.g. linux-x64}"
destination="${2:?destination path for the binary}"
case "$platform" in
    win32-x64) member="package/bin/agent-browser-win32-x64.exe" ;;
    linux-x64 | linux-arm64 | darwin-x64 | darwin-arm64) member="package/bin/agent-browser-$platform" ;;
    *) echo "unsupported platform: $platform" >&2; exit 1 ;;
esac

# macOS ships shasum rather than sha512sum.
checksum() {
    if command -v sha512sum >/dev/null 2>&1; then
        sha512sum "$1" | cut -d' ' -f1
    else
        shasum -a 512 "$1" | cut -d' ' -f1
    fi
}

cache="${XDG_CACHE_HOME:-$HOME/.cache}/noah-build"
tarball="$cache/agent-browser-$VERSION.tgz"
mkdir -p "$cache"
if [[ ! -f "$tarball" ]] || [[ "$(checksum "$tarball")" != "$SHA512" ]]; then
    curl --fail --location --silent --show-error \
        "https://registry.npmjs.org/agent-browser/-/agent-browser-$VERSION.tgz" -o "$tarball.partial"
    mv "$tarball.partial" "$tarball"
fi
if [[ "$(checksum "$tarball")" != "$SHA512" ]]; then
    echo "agent-browser $VERSION failed its checksum; refusing to use it" >&2
    exit 1
fi

scratch="$(mktemp -d)"
trap 'rm -rf "$scratch"' EXIT
tar -xzf "$tarball" -C "$scratch" "$member" package/LICENSE
mkdir -p "$(dirname "$destination")"
cp "$scratch/$member" "$destination"
chmod +x "$destination"
cp "$scratch/package/LICENSE" "$(dirname "$destination")/agent-browser-LICENSE"
echo "agent-browser $VERSION ($platform) -> $destination"
