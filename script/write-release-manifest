#!/usr/bin/env bash
# Write latest.json, the manifest noah's updater reads, for the installers in
# a directory (normally the website's public/downloads), signed with noah's
# release key. When asherin-eye.tar.gz (from script/package-asherin-eye) is
# there too, it is listed and signed as the `asherin-eye` asset.
#
# Usage: NOAH_RELEASE_SIGNING_KEY_FILE=<key.pem> script/write-release-manifest <downloads-dir> <public-base-url>
#   e.g. script/write-release-manifest ../unlocket/public/downloads https://noah.asherin.com/downloads
# The build number is the commit time, the same value the release scripts
# stamp into noah as NOAH_BUILD, so run this from the commit that was built.
#
# The signature is ed25519 over this text, with the assets in byte order of
# their keys; the updater rebuilds it the same way, so the two must agree:
#   noah-release\n<build>\n<version>\n<key> <url> <sha256>\n...
# Needs OpenSSL 3.

set -euo pipefail
cd "$(dirname "$0")/.."

directory="${1:?downloads directory}"
base_url="${2:?public base URL of that directory}"
base_url="${base_url%/}"
signing_key="${NOAH_RELEASE_SIGNING_KEY_FILE:?set NOAH_RELEASE_SIGNING_KEY_FILE to the release signing key, see script/generate-release-key}"
[[ -f "$signing_key" ]] || { echo "no signing key at $signing_key" >&2; exit 1; }
build="${NOAH_BUILD:-$(git log -1 --format=%ct)}"
version="$(date -u -d "@$build" +%Y.%-m.%-d 2>/dev/null || date -u -r "$build" +%Y.%-m.%-d)"

# A key other than the committed one would produce manifests every installed
# copy rejects, so refuse it here instead.
expected_public_key="$(tr -d ' \n' < crates/auto_update/release_public_key.txt)"
actual_public_key="$(openssl pkey -in "$signing_key" -pubout -outform DER | tail -c 32 | od -An -v -tx1 | tr -d ' \n')"
if [[ "$actual_public_key" != "$expected_public_key" ]]; then
    echo "$signing_key isn't the key in crates/auto_update/release_public_key.txt" >&2
    exit 1
fi

keys=()
urls=()
sums=()
for pair in \
    "windows-x86_64:noah-windows-x86_64.exe" \
    "linux-x86_64:noah-linux-x86_64.tar.xz" \
    "linux-aarch64:noah-linux-aarch64.tar.xz" \
    "asherin-eye:asherin-eye.tar.gz"; do
    file="${pair#*:}"
    [[ -f "$directory/$file" ]] || continue
    keys+=("${pair%%:*}")
    urls+=("$base_url/$file")
    sums+=("$(sha256sum "$directory/$file" | cut -d' ' -f1)")
done

message="$(mktemp)"
trap 'rm -f "$message"' EXIT
{
    printf 'noah-release\n%s\n%s\n' "$build" "$version"
    for index in "${!keys[@]}"; do
        printf '%s %s %s\n' "${keys[$index]}" "${urls[$index]}" "${sums[$index]}"
    done | LC_ALL=C sort
} > "$message"
signature="$(openssl pkeyutl -sign -rawin -inkey "$signing_key" -in "$message" | openssl base64 -A)"

{
    echo "{"
    echo "  \"build\": $build,"
    echo "  \"version\": \"$version\","
    echo "  \"assets\": {"
    for index in "${!keys[@]}"; do
        separator=","
        [[ "$index" -eq $((${#keys[@]} - 1)) ]] && separator=""
        printf '    "%s": { "url": "%s", "sha256": "%s" }%s\n' \
            "${keys[$index]}" "${urls[$index]}" "${sums[$index]}" "$separator"
    done
    echo "  },"
    echo "  \"signature\": \"$signature\""
    echo "}"
} > "$directory/latest.json"
cat "$directory/latest.json"
