#!/usr/bin/env bash
# Build the noah Windows installer from a Linux machine (no Windows or CI needed).
#
# Produces dist/noah-windows-x86_64.exe: a per-user, one-click installer.
#
# Requirements: llvm-mingw (https://github.com/mstorsjo/llvm-mingw) on PATH,
# nsis, and Rust (rustup).
#
# Usage: script/build-windows-cross [VERSION]

set -euo pipefail
cd "$(dirname "$0")/.."

VERSION="${1:-$(script/get-crate-version zed)}"
# gnullvm rather than gnu: the gnu target keeps Rust thread-locals in OS TLS
# slots instead of native TLS, and the release built that way failed HTTP
# requests on Windows with Tokio's "there is no reactor running". gnullvm uses
# native thread-locals, like the official MSVC build.
TARGET=x86_64-pc-windows-gnullvm

command -v x86_64-w64-mingw32-clang >/dev/null || { echo "missing llvm-mingw" >&2; exit 1; }
command -v makensis >/dev/null || { echo "missing nsis (makensis)" >&2; exit 1; }

rustup target add "$TARGET"

# Stable channel so the app is branded "noah". 8 MiB main-thread stack matches the
# native MSVC build (see crates/zed/build.rs). LTO off keeps cross builds tractable.
export ZED_RELEASE_CHANNEL=stable
# Read by the Windows resource script for the exe icon and product name.
export RELEASE_CHANNEL=stable
# The release's build number, which noah's updater compares: the commit time.
export NOAH_BUILD="${NOAH_BUILD:-$(git log -1 --format=%ct)}"
# Setting this replaces the rustflags in .cargo/config.toml, so repeat them.
export CARGO_TARGET_X86_64_PC_WINDOWS_GNULLVM_RUSTFLAGS="-C symbol-mangling-version=v0 --cfg tokio_unstable --cfg windows_slim_errors -C target-feature=+crt-static -C link-arg=-Wl,--stack,8388608"
export CARGO_PROFILE_RELEASE_LTO=false
export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=16
export CARGO_PROFILE_RELEASE_DEBUG=false

cargo build --release -p zed -p cli --target "$TARGET"

stage="$(mktemp -d)"
trap 'rm -rf "$stage"' EXIT
# Same layout as the official Windows installer (script/bundle-windows.ps1).
mkdir -p "$stage/bin" "$stage/x64"
cp "target/$TARGET/release/zed.exe" "$stage/noah.exe"
cp "target/$TARGET/release/cli.exe" "$stage/bin/zed.exe"
llvm-strip "$stage/noah.exe" "$stage/bin/zed.exe"
# shepherd's browser: noah looks for agent-browser.exe beside noah.exe.
script/fetch-agent-browser win32-x64 "$stage/agent-browser.exe"

# ConPTY gives the integrated terminal full functionality. crates/zed/build.rs
# fetches it only on Windows hosts, so fetch the same package here.
conpty_url="https://github.com/microsoft/terminal/releases/download/v1.25.1912.0/Microsoft.Windows.Console.ConPTY.1.25.260710002-preview.nupkg"
conpty_dir="$(mktemp -d)"
curl -fsSL "$conpty_url" -o "$conpty_dir/conpty.zip"
(cd "$conpty_dir" && unzip -q conpty.zip)
cp "$conpty_dir/runtimes/win-x64/native/conpty.dll" "$stage/conpty.dll"
cp "$conpty_dir/build/native/runtimes/x64/OpenConsole.exe" "$stage/x64/OpenConsole.exe"
rm -rf "$conpty_dir"

# Ship any llvm-mingw runtime DLLs (libc++, libunwind) the executable links against.
runtime_bin="$(dirname "$(command -v x86_64-w64-mingw32-clang)")/../x86_64-w64-mingw32/bin"
for dll in $(llvm-objdump -p "$stage/noah.exe" "$stage/bin/zed.exe" | awk '/DLL Name/ {print $3}' | sort -u); do
    if [ -f "$runtime_bin/$dll" ]; then cp "$runtime_bin/$dll" "$stage/"; fi
done

mkdir -p dist
out="$PWD/dist/noah-windows-x86_64.exe"
(cd script/installer && makensis -V2 -DVERSION="$VERSION" -DSTAGE="$stage" -DOUTFILE="$out" noah.nsi)
echo "built $out"
