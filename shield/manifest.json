  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src https://noah.asherin.com https://haveibeenpwned.com https://api.ivpn.net https://timing.cloudflare.com; base-uri 'none'; form-action 'none'"
